NODE_ENV=development
PORT=4174
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4174
DATABASE_URL=postgres://manabinder:local-only@127.0.0.1:5432/manabinder
# Generate at least 32 random bytes; required even though session IDs are opaque.
SESSION_SECRET=replace-with-at-least-32-random-bytes
SCRYFALL_USER_AGENT=ManaBinder/0.2 contact=replace@example.com
MAIL_MODE=file
MAIL_DIR=work/mail
# Production: MAIL_MODE=webhook, MAIL_WEBHOOK=https://..., MAIL_TOKEN=...
# TRUST_PROXY=false; only enable behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
ADMIN_IDS=
CATALOG_MAX_AGE_DAYS=180
